ARG UBUNTU_IMAGE
FROM ${UBUNTU_IMAGE} AS builder

ARG NPROC=2
ARG QWC_REPOSITORY=https://github.com/qwertycoin-org/qwertycoin.git
ARG QWC_COMMIT
ENV DEBIAN_FRONTEND=noninteractive
ENV CFLAGS=-fPIC
ENV CXXFLAGS=-fPIC
ENV USE_SINGLE_BUILDDIR=1
ENV BOOST_DEBUG=1

RUN apt-get update && \
    apt-get --no-install-recommends --yes install \
      automake \
      autotools-dev \
      bsdmainutils \
      build-essential \
      ca-certificates \
      cmake \
      curl \
      git \
      gperf \
      graphviz \
      libboost-all-dev \
      libcurl4-openssl-dev \
      libgtest-dev \
      libhidapi-dev \
      libhidapi-libusb0 \
      libreadline-dev \
      libsodium-dev \
      libssl-dev \
      libtool \
      libunbound-dev \
      libunwind8-dev \
      libzmq3-dev \
      miniupnpc \
      pkg-config \
      zip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /root
RUN expr "${QWC_COMMIT}" : '[0-9a-fA-F]\{40\}$' >/dev/null
RUN git clone --filter=blob:none --no-checkout "${QWC_REPOSITORY}" /root/qwertycoin && \
    git -C /root/qwertycoin checkout --detach "${QWC_COMMIT}" && \
    git -C /root/qwertycoin submodule update --init --recursive

COPY deploy/boost_pthread_compat.h /tmp/boost_pthread_compat.h
RUN cd /root/qwertycoin/contrib/depends && \
    make -j"${NPROC}" \
      boost_cxxflags="-std=c++11 -fPIC -include /tmp/boost_pthread_compat.h" \
      HOST=x86_64-linux-gnu

RUN mkdir -p /root/qwertycoin/build/x86_64-linux-gnu/release && \
    cd /root/qwertycoin/build/x86_64-linux-gnu/release && \
    cmake \
      -DCMAKE_CXX_FLAGS="-include /tmp/boost_pthread_compat.h" \
      -DCMAKE_TOOLCHAIN_FILE=/root/qwertycoin/contrib/depends/x86_64-linux-gnu/share/toolchain.cmake \
      ../../.. && \
    make -j"${NPROC}"

ARG EXPLORER_SOURCE_SHA
ARG EXPLORER_SOURCE_DATE=unknown
ARG EXPLORER_SOURCE_BRANCH=detached
RUN expr "${EXPLORER_SOURCE_SHA}" : '[0-9a-fA-F]\{40\}$' >/dev/null

RUN apt-get update && \
    apt-get --no-install-recommends --yes install \
      libasio-dev \
      liblzma-dev \
      libusb-1.0-0-dev \
      libminiupnpc-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY . /root/qwertycoin-explorer
WORKDIR /root/qwertycoin-explorer/build

RUN cmake \
      -DCMAKE_LIBRARY_PATH="/root/qwertycoin/build/x86_64-linux-gnu/release;/root/qwertycoin/contrib/depends/x86_64-linux-gnu/lib" \
      -DBOOST_ROOT=/root/qwertycoin/contrib/depends/x86_64-linux-gnu \
      -DBOOST_INCLUDEDIR=/root/qwertycoin/contrib/depends/x86_64-linux-gnu/include \
      -DBOOST_LIBRARYDIR=/root/qwertycoin/contrib/depends/x86_64-linux-gnu/lib \
      -DBoost_NO_BOOST_CMAKE=ON \
      -DBoost_NO_SYSTEM_PATHS=ON \
      -DMONERO_DIR=/root/qwertycoin \
      -DMONERO_SOURCE_DIR=/root/qwertycoin \
      -DMONERO_BUILD_DIR=/root/qwertycoin/build/x86_64-linux-gnu/release \
      -DEXPLORER_SOURCE_SHA="${EXPLORER_SOURCE_SHA}" \
      -DEXPLORER_SOURCE_DATE="${EXPLORER_SOURCE_DATE}" \
      -DEXPLORER_SOURCE_BRANCH="${EXPLORER_SOURCE_BRANCH}" \
      -DQWC_SOURCE_SHA="${QWC_COMMIT}" \
      .. && \
    make -j"${NPROC}" && \
    ctest --output-on-failure

RUN zip /lib.zip $(ldd qwertycoin-explorer | grep -E '/[^ ]*' -o)

FROM ${UBUNTU_IMAGE} AS final

ARG QWC_COMMIT
ARG EXPLORER_SOURCE_SHA
LABEL org.opencontainers.image.source="https://github.com/qwertycoin-org/explorer-qwertycoin-org.github.io" \
      org.opencontainers.image.revision="${EXPLORER_SOURCE_SHA}" \
      org.qwertycoin.core.revision="${QWC_COMMIT}"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get --no-install-recommends --yes install ca-certificates curl unzip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /lib.zip /tmp/lib.zip
RUN unzip -o /tmp/lib.zip -d / && \
    rm -f /tmp/lib.zip && \
    apt-get purge --yes unzip && \
    apt-get autoremove --yes && \
    useradd --system --uid 101 --create-home --home-dir /home/qwertycoin qwertycoin && \
    mkdir -p /home/qwertycoin/.qwertycoin && \
    chown -R qwertycoin:qwertycoin /home/qwertycoin

USER qwertycoin
WORKDIR /home/qwertycoin

COPY --chown=qwertycoin:qwertycoin --from=builder /root/qwertycoin-explorer/build/qwertycoin-explorer ./qwertycoin-explorer
COPY --chown=qwertycoin:qwertycoin --from=builder /root/qwertycoin-explorer/build/templates ./templates

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD ["curl", "--fail", "--silent", "--show-error", "http://127.0.0.1:8081/readyz"]
ENTRYPOINT ["./qwertycoin-explorer"]
CMD ["--port", "8081", "--bindaddr", "0.0.0.0", "--bc-path", "/home/qwertycoin/.qwertycoin/lmdb", "--daemon-url", "http://qwertycoin-mainnet:8198", "--enable-json-api"]
